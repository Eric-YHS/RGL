# Production API base URL (optional).
# Empty means use same-origin, e.g. https://your-domain.com/api/...
VITE_API_BASE_URL=

# Dev proxy target for vite.config.ts
VITE_DEV_API_TARGET=http://localhost:8787

# Optional Jianshu/见数 questionnaire URL shown after the decision task is saved.
VITE_SURVEY_URL=

# Optional API hardening controls.
# POST_ALLOWED_ORIGINS defaults to the production domains and local Vite dev hosts.
POST_ALLOWED_ORIGINS=https://experiments.top,https://www.experiments.top,https://m.experiments.top
SUBMISSION_RATE_LIMIT_WINDOW_MS=600000
SUBMISSION_RATE_LIMIT_MAX=300

# Admin export page (/admin/) controls.
# EXPORT_ADMIN_ENABLED must be exactly "true" to expose the management API (default off).
EXPORT_ADMIN_ENABLED=false
# SHA-256 hex digest (64 chars) of the admin export token. Never put the plaintext token here.
# Generate: printf '%s' 'your-32+byte-random-token' | sha256sum
EXPORT_ADMIN_TOKEN_SHA256=
# Single-export hard caps: sessions and events.
EXPORT_MAX_SESSIONS=5000
EXPORT_MAX_EVENTS=100000
# Time zone used to interpret filter times and display Beijing time columns.
EXPORT_TIME_ZONE=Asia/Shanghai
