# Production API base URL (optional).
# Empty means use same-origin, e.g. https://your-domain.com/api/...
VITE_API_BASE_URL=

# Dev proxy target for vite.config.ts
VITE_DEV_API_TARGET=http://localhost:8787

# Optional Jianshu/见数 questionnaire URL shown after the decision task is saved.
VITE_SURVEY_URL=

# Optional API hardening controls.
# POST_ALLOWED_ORIGINS defaults to the production domains and local Vite dev hosts.
POST_ALLOWED_ORIGINS=https://experiments.top,https://www.experiments.top,https://m.experiments.top
SUBMISSION_RATE_LIMIT_WINDOW_MS=600000
SUBMISSION_RATE_LIMIT_MAX=300
